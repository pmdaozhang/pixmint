# 复制到 /etc/pixmint-license/env，权限 600 root:root
PIXMINT_LICENSE_DB=/var/lib/pixmint-license/license.db
PIXMINT_LICENSE_KEY=/etc/pixmint-license/ed25519.key
PIXMINT_LICENSE_KID=prod-1
PIXMINT_BASE_URL=https://data.hugproducthub.top
PIXMINT_ADMIN_TOKEN=请替换为随机长字符串
PIXMINT_ORDERS_TOKEN=请替换为另一条随机长字符串

# 手机确认：企业微信应用消息（优先）与签名链接密钥
PIXMINT_WECOM_CORP_ID=
PIXMINT_WECOM_AGENT_ID=
PIXMINT_WECOM_SECRET=
# 企业微信「接收消息服务器 URL」校验用
PIXMINT_WECOM_CALLBACK_TOKEN=
PIXMINT_WECOM_CALLBACK_AES_KEY=
PIXMINT_ACTION_SECRET=请替换为随机长字符串
# PushPlus 作为企业微信发送失败时的兜底
PIXMINT_PUSHPLUS_TOKEN=

# 面包多Pay（审核通过后填写）
MBD_APP_ID=
MBD_APP_KEY=
MBD_API_BASE=https://newapi.mbd.pub

# 邮件（腾讯云 SES SMTP）
PIXMINT_SMTP_HOST=
PIXMINT_SMTP_PORT=465
PIXMINT_SMTP_USER=
PIXMINT_SMTP_PASSWORD=
PIXMINT_SMTP_FROM=Pixmint <noreply@pixmint.hugproducthub.top>
